# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: primary Gemini model (default: gemini-4-hydrogen, the strongest
# model available on the free key). Fallbacks are Gemini 3.x/Flash variants.
# GEMINI_MODEL=gemini-4-hydrogen

# Extra AI providers (optional). CODEPLUS tries them in order if Gemini fails.
# A keyless Pollinations fallback is always available as the last resort.
# Image generation (!img) also needs no key: Gemini first, then keyless Pollinations.
# Groq free key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter free key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Render-only session mode: QR is disabled by default. The bot restores the
# linked session from the wa-creds.json Render Secret File after every deploy.
# Set FORCE_QR=true only for a deliberate manual re-link; it will print a QR.
# FORCE_QR=false

# Pairing mode is also opt-in. Set true only if you deliberately want a code.
# USE_PAIRING_CODE=false

# Optional: secret file path / raw JSON (Render Secret Files are mounted here).
# WA_CREDENTIALS_PATH=/etc/secrets/wa-creds.json
# WA_CREDENTIALS={"me":{...},"signedIdentityKey":{...}}

# WhatsApp account, digits only with country code. Used only for pairing codes.
# Default: 919073846974 (+91 90738 46974)
# PHONE_NUMBER=919073846974

# Caller ID: also run a public web lookup when a call arrives (slower).
# CALLERID_LOOKUP_ON_CALL=false

# On Render, PORT is set automatically. Only add it if you host elsewhere.
# PORT=10000
