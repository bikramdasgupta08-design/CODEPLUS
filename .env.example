# Get a free key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: primary Gemini model (default: gemini-3.8-flash).
# Fallbacks are gemini-flash-lite-latest and gemini-3.5-flash.
# GEMINI_MODEL=gemini-3.8-flash

# Extra AI providers (optional). CODEPLUS tries them in order if Gemini fails.
# Groq free key: https://console.groq.com/keys
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter free key: https://openrouter.ai/keys
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# OpenAI (paid): https://platform.openai.com/api-keys
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# WhatsApp account to link, digits only with country code.
# Used for the short 8-character pairing code instead of a QR in logs.
# Default: 919073846974 (+91 90738 46974)
# PHONE_NUMBER=919073846974

# On Render, PORT is set automatically. Only add it if you host elsewhere.
# PORT=10000
